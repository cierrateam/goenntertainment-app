# CI-ONLY settings for deploy/docker-compose.yml. NOT for any real server.
#
# Used by .github/workflows/docker.yml and the deploy tests (deploy/test/), and by anyone who
# starts the stack locally for a test: from deploy/, always with the CI override and a project
# name of its own, in the order of deploy/README.md (First start: everything but caddy, the seed,
# then the rest; caddy waits for an admin account):
#   docker compose -p <name> --env-file ci.env -f docker-compose.yml -f docker-compose.ci.yml ...
# The stack test does all of it, checks and removal included: README.md "Tests and checks".
#
# Every value here is public and fake on purpose, and none of them is a recommendation for a
# real server: a real server gets its own deploy/.env (deploy/.env.example says who decides each
# value); never copy a value from this file. Secret-like settings carry the marker
# "not-a-secret" in their value (checked by scripts/ci/check-workflows.mjs).
# Settings that later changes make required get a labelled ci-only value here as well.
# localhost: Caddy then uses its own internal certificate authority; no public name, no ACME.
DOMAIN=localhost
DB_PASSWORD=ci-only-not-a-secret-db
DB_ROOT_PASSWORD=ci-only-not-a-secret-root
# Exactly 32 characters, the key length Laravel's AES-256 cipher needs (a raw key without
# the base64: prefix is valid). The stack test (deploy/test/stack.test.mjs) replaces it with a
# fresh random key for every run, in CI and locally; it is here only so this file alone is
# enough for `docker compose config` and a stack started by hand.
APP_KEY=ci-only-fake-key-not-a-secret-00
# First three parts of the stack's private /24 network (fixed proxy address; see the compose).
APP_NET_PREFIX=172.30.99
# Payments: `test` books without real money, so the stack test can buy credits. CI-ONLY, NOT a
# decision for a real server (deploy/.env.example).
PAYMENTS_MODE=test
# Retention in days (required by the scheduler's prune, api/app/Support/Retention.php). CI-ONLY
# placeholder values for the stack test, NOT a retention decision: a real server sets its own
# (deploy/.env.example).
EVIDENCE_RETENTION_DAYS=30
TOKEN_RETENTION_DAYS=1
# Mail (required): CI-ONLY. SMTP to Mailpit, the mail catcher docker-compose.ci.yml runs under
# this name; it takes mail without a login. No managed identity in CI, so MAIL_GRAPH_CLIENT_ID
# is empty (the graph mailer is tested with a faked HTTP client, api/tests/Feature/
# GraphTransportTest.php). The sender is a reserved, non-existent domain.
MAIL_MAILER=smtp
MAIL_GRAPH_CLIENT_ID=
MAIL_HOST=mailpit
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=ci-only@example.invalid
# Backups (required): CI-ONLY values, NOT a retention decision. docker-compose.ci.yml replaces the
# BACKUP_DIR mount with a throw-away volume, so this path is never used.
BACKUP_DIR=/ci-only-not-used
BACKUP_RETENTION_DAYS=7
# Logs and the MySQL binary log (required): CI-ONLY values, NOT a retention decision.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
MYSQL_BINLOG_RETENTION_DAYS=1
