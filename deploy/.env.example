# Vorlage für deploy/.env – DIESE Datei kommt auf den Server, nicht ins Git.
#
# Copy it so that only you can read it, fill it in, then check it:
#   install -m 600 .env.example .env
#   scripts/preflight.sh
#
# Every setting below without a leading `#` is REQUIRED: docker compose refuses to start until
# it is set (deploy/README.md). A value marked DECISION is a business or retention decision that
# nobody may guess: the named role fills it in. The other required values are technical (random
# secrets, a free network range). Optional settings are commented out; their defaults are in the
# code or the compose.

# --- Domain and the edge's TLS files -------------------------------------------
# DECISION (the operator, with the domain owner): the domain under which the app reaches its
# backend, e.g. a subdomain of the business domain. A proxied record at Cloudflare, with the
# hosting platform's load balancer behind it; never a record that points straight to the server
# (deploy/README.md, Cloudflare and the load balancer). The origin certificate must name it.
# HSTS covers this name only; includeSubDomains/preload for the whole business domain is a
# further DECISION of the domain owner (deploy/Caddyfile).
DOMAIN=

# Technical (the operator): the folder on this host with the origin certificate, its key and the
# origin-pull CA, root-owned and outside this clone; scripts/preflight.sh checks each file
# (deploy/README.md, Origin certificate and Authenticated Origin Pulls).
ORIGIN_TLS_DIR=

# --- Secrets (technical: generate them, keep a copy in a password manager) -----
# Datenbank-Passwörter. Frei erfinden, aber lang. Erzeugen z. B. mit:
#   openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Schlüssel, mit dem Laravel verschlüsselt (u. a. die Geheimnisse der
# Zwei-Faktor-Anmeldung). Erzeugen mit:
#   echo "base64:$(openssl rand -base64 32)"
# EINMAL erzeugen und nie wieder ändern: Mit einem neuen Schlüssel lassen sich
# gespeicherte 2FA-Geheimnisse nicht mehr lesen, und alle mit 2FA kämen nicht
# mehr in ihr Konto. Backups are of no use for two-factor accounts without it.
APP_KEY=

# --- Network (technical) -----------------------------------------------------
# The containers' private network: the first three parts of a /24 that is not used on this
# host (check with `ip -4 addr` and `docker network inspect`), e.g. 172.30.42 for 172.30.42.0/24.
# The compose puts the network of caddy and api into <prefix>.0/25, with caddy at .10: Laravel
# trusts the client address only from there. api is at .20, and the scheduler's way out at
# <prefix>.140 in <prefix>.128/25: the host lets these two reach the metadata endpoint for the
# graph mailer's token (scripts/metadata-access.sh).
APP_NET_PREFIX=

# --- Payments ------------------------------------------------------------------
# DECISION (the operator, with whoever answers for the business): `off` or `test`.
#   off   buying credits, club plans and paid bookings is refused (the app says so)
#   test  everything goes through without real money - for a closed test with friends only:
#         on a public server anyone gets credits and club plans for nothing
# Real payments need a payment provider first; the code has none yet (api/app/Support/
# Payments.php). Any other value works like `off`; scripts/preflight.sh refuses it.
PAYMENTS_MODE=

# --- Mail (two-factor, password-reset and e-mail-change codes, credit reminders) ---
# DECISION (the operator): how mail goes out, and the sender mailbox. Without working mail no
# code arrives.
#   MAIL_MAILER=graph  Microsoft Graph, signed in as the server's managed identity
#                      (MAIL_GRAPH_CLIENT_ID below; what the platform and Microsoft 365 provide:
#                      deploy/README.md, Mail through Microsoft Graph). MAIL_HOST, MAIL_USERNAME
#                      and MAIL_PASSWORD stay empty.
#   MAIL_MAILER=smtp   an SMTP provider: MAIL_HOST is required. MAIL_USERNAME and MAIL_PASSWORD
#                      stay empty only for a relay that takes mail without a login. MAIL_PORT
#                      defaults to 587; MAIL_SCHEME=smtps for TLS from the start (port 465).
# Every line must be in this file, empty where the chosen way does not use it: api and the
# scheduler do not start without a setting the chosen way needs, and scripts/preflight.sh checks
# it first. MAIL_FROM_ADDRESS is the sender of every mail; with graph, the mailbox the identity
# may send as.
MAIL_MAILER=
MAIL_FROM_ADDRESS=
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_PORT=587
# MAIL_SCHEME=

# Technical, for MAIL_MAILER=graph: the client ID of the server's user-assigned managed identity,
# a GUID, as the hosting platform's stack outputs it. Not a secret: the token comes from the
# server's metadata endpoint, and nothing expires. Empty with smtp.
MAIL_GRAPH_CLIENT_ID=

# --- Retention (required, an operator decision) ------------------------------
# DECISION (the operator, with whoever answers for data protection): how many days data that is
# no longer needed is kept; the scheduler deletes it every hour after that
# (api/app/Support/Retention.php; `docker compose exec scheduler php artisan retention:prune`
# runs it once). There are no defaults: decide each value, then the stack starts. Whole days,
# at least 1.
#   EVIDENCE_RETENTION_DAYS  evidence images of bans and timeouts (the image goes, the record
#                            stays). Applies to active bans too.
#   TOKEN_RETENTION_DAYS     expired sign-in tokens and two-factor, reset and e-mail challenges,
#                            counted from their expiry.
EVIDENCE_RETENTION_DAYS=
TOKEN_RETENTION_DAYS=

# --- Backups (required) -------------------------------------------------------
# The backup service writes a database dump and an archive of the uploads every night at
# 02:30 UTC (and once when it starts), and deletes sets older than BACKUP_RETENTION_DAYS after
# each successful run (deploy/scripts/backup.sh).
# DECISION (the operator): where the backups live on this host, who looks after them, and whether
# and where an offsite copy goes. BACKUP_DIR is an absolute path OUTSIDE this clone, owned by
# root with mode 700 (create it with `install -d -m 700 -o root -g root <path>`;
# scripts/preflight.sh checks all of it). The backups hold personal data: the same care as the
# database.
BACKUP_DIR=
# DECISION (the operator, with whoever answers for data protection): how many days a backup set
# is kept. Whole days, at least 1.
BACKUP_RETENTION_DAYS=

# --- Logs (required) ----------------------------------------------------------
# DECISION (the operator, with whoever answers for data protection): how much log is kept. Every
# container's log (including caddy's access log: client address, method and full address of
# each request) is rotated by size: at most LOG_MAX_FILES files of LOG_MAX_SIZE each, per
# container. Docker rotates by size, not by time; size the two values for the period you decide.
# LOG_MAX_SIZE: a size with the unit k, m or g (e.g. 10m).
# LOG_MAX_FILES: a number, at least 2 (Docker's local log driver compresses the rotated files and
# refuses a single file: with 1 no container starts).
LOG_MAX_SIZE=
LOG_MAX_FILES=
# DECISION (the operator, with whoever answers for data protection): how many days MySQL keeps its
# binary log, which records every change, also the rows of deleted accounts. Whole days from 1 to
# 9999, or `off` (then no binary log: no restore to a point in time between two backups).
# MySQL's own default would be 30 days; 0 is refused (it would mean "keep forever"). The db
# service rotates the log once a day, and MySQL deletes a file once its last write is older than
# this: a change stays in the binary log at least this many days and at most two days longer.
# The backups (BACKUP_RETENTION_DAYS) keep their own copy of the data.
MYSQL_BINLOG_RETENTION_DAYS=

# --- Sessions (optional) ------------------------------------------------------
# Access tokens end this many minutes after sign-in; then the app asks to sign in again.
# Default (unset): 43200 = 30 days. Only a positive whole number is accepted.
# api refuses a token issued longer ago, so a lower value also ends older sessions as soon as
# the containers run with it (docker compose up -d); the scheduler's prune counts from it too.
# SANCTUM_EXPIRATION=43200

# --- Admin account ------------------------------------------------------------
# Not here: the first admin account is created once with the one-off seed service, with the
# address and password typed in for that one run only (deploy/README.md, first start). They
# never belong in this file or in a long-running container. Further admins: an existing account,
# `docker compose exec api php artisan admin:grant <address>`.

# --- Auth limits (optional, api/config/ratelimits.php) ------------------------
# Sign-up, sign-in, password and two-factor routes; rules max/seconds, comma-separated (for
# example 10/600,30/3600 = at most 10 in 10 minutes and 30 in an hour). Unset or empty = the
# code's defaults (api/.env.example shows them). An invalid value stops the api container's
# start. Variables:
# AUTH_LIMIT_REGISTER_IP, AUTH_LIMIT_REGISTER_ACCOUNT, AUTH_LIMIT_LOGIN_ACCOUNT_IP,
# AUTH_LIMIT_LOGIN_IP, AUTH_LIMIT_LOGIN_ACCOUNT, AUTH_LIMIT_FORGOT_IP, AUTH_LIMIT_FORGOT_ACCOUNT,
# AUTH_LIMIT_RESET_IP, AUTH_LIMIT_RESET_ACCOUNT, AUTH_LIMIT_2FA_CHALLENGE, AUTH_LIMIT_2FA_IP,
# AUTH_LIMIT_2FA_ACCOUNT, AUTH_LIMIT_2FA_RESEND_IP, AUTH_LIMIT_2FA_RESEND_ACCOUNT,
# AUTH_LIMIT_2FA_SETUP_USER, AUTH_LIMIT_ACCOUNT_SENSITIVE_USER, AUTH_LIMIT_PROFILE_USER,
# AUTH_LIMIT_2FA_FAILURES, AUTH_LIMIT_LOCK_WAIT (seconds a request waits for a limiter lock)
