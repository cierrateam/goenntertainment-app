APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Development: the local mail catcher (Mailpit, see README "Mail in development") receives every
# mail; read it at http://127.0.0.1:8025. Never use the log mailer: codes must not land in a log.
# A server sends through Microsoft Graph as its managed identity (MAIL_MAILER=graph with
# MAIL_GRAPH_CLIENT_ID) or through SMTP: deploy/README.md, Settings. Graph works only on that
# server, so it has no line here.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Addresses of the reverse proxies whose X-Forwarded-* headers Laravel believes (config/
# trustedproxy.php). Empty in development (no proxy in front); never '*'.
TRUSTED_PROXIES=

# Optional: access tokens end this many minutes after sign-in (config/sanctum.php). Default
# (unset): 43200 = 30 days; only a positive whole number is accepted.
# SANCTUM_EXPIRATION=43200

# Optional in development, required in production: retention in days for the hourly prune
# (`php artisan retention:prune`, config/retention.php). Both or none; none prunes nothing.
# EVIDENCE_RETENTION_DAYS=
# TOKEN_RETENTION_DAYS=

# Optional overrides of the sign-in, sign-up, password and two-factor rate limits
# (config/ratelimits.php explains the scopes; "max/seconds" rules, comma-separated). The values
# shown are the defaults in code. The counters need CACHE_STORE=database (the `cache` table of
# server/schema.sql).
# AUTH_LIMIT_REGISTER_IP=10/600,30/3600
# AUTH_LIMIT_REGISTER_ACCOUNT=5/3600
# AUTH_LIMIT_LOGIN_ACCOUNT_IP=10/60
# AUTH_LIMIT_LOGIN_IP=30/60
# AUTH_LIMIT_LOGIN_ACCOUNT=50/3600,200/86400
# AUTH_LIMIT_FORGOT_IP=5/600,20/3600
# AUTH_LIMIT_FORGOT_ACCOUNT=3/3600,10/86400
# AUTH_LIMIT_RESET_IP=10/600
# AUTH_LIMIT_RESET_ACCOUNT=10/3600
# AUTH_LIMIT_2FA_CHALLENGE=10/60
# AUTH_LIMIT_2FA_IP=30/60
# AUTH_LIMIT_2FA_ACCOUNT=30/3600
# AUTH_LIMIT_2FA_RESEND_IP=10/60
# AUTH_LIMIT_2FA_RESEND_ACCOUNT=5/600,20/86400
# AUTH_LIMIT_2FA_SETUP_USER=10/60,30/3600
# AUTH_LIMIT_ACCOUNT_SENSITIVE_USER=10/60,30/3600
# AUTH_LIMIT_PROFILE_USER=30/60,300/3600
# AUTH_LIMIT_2FA_FAILURES=10/900
# Seconds a request waits for the lock around a check and its count before it gets a 429.
# AUTH_LIMIT_LOCK_WAIT=5
