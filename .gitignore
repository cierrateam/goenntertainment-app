# Database dumps and logs never belong in the repository. The schema is source.
*.sql
*.sql.gz
!/server/schema.sql
# Source too: the db service's first-start event that rotates the binary log.
!/deploy/mysql/02-binlog-rotate.sql
*.log
/logs/

