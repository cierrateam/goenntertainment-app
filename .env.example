# Vorlage fuer `.env.local` (die echte Datei liegt nicht im Git).
#
# Kopieren:  cp .env.example .env.local
#
# `EXPO_PUBLIC_`-Variablen werden von Metro beim Buendeln in den Code eingesetzt
# (siehe src/constants/config.ts). Sie stehen im fertigen Bundle im Klartext –
# also nur Adressen hier ablegen, keine Schluessel oder Passwoerter.

# Adresse des Backends (Laravel aus `api/`). Zwei Faelle:
#
#   1. Normalfall            -> der Server unter der eigenen Domain, https://goe4fun.de
#                               (geht ueber WLAN und Mobilfunk; die gebauten Apps
#                               bekommen dieselbe Adresse aus eas.json)
#   2. API-Aenderungen testen -> das eigene Laravel auf Port 8000 ueber die LAN-IP
#                               dieses PCs, z. B. http://192.168.0.10:8000
#                               (Handy muss im selben WLAN sein)
#
# Ohne diesen Wert raet die App die Adresse aus der Metro-Verbindung – das geht
# oft schief (127.0.0.1 oder Hamachi-VPN) und endet im Login-Timeout.
EXPO_PUBLIC_API_URL=https://goe4fun.de
